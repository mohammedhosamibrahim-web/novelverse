# ── Server ─────────────────────────────────────────────────────────────
PORT=3000
# CHANGE THIS IN PRODUCTION — use a long random string (openssl rand -hex 32)
JWT_SECRET=dev-secret-CHANGE-ME
JWT_EXPIRES_IN=7d
# Absolute or relative path to the SQLite database file
DB_PATH=./data/app.db
NODE_ENV=development

# ── MangaDex sync (bulk) ────────────────────────────────────────────────
# MangaDex requires a descriptive User-Agent for the API. Include a contact.
MANGADEX_UA=WebNovelPlatform/1.0 (contact@example.com)
# Image CDN requests use a browser-like UA + Referer (per project spec)
MANGADEX_IMAGE_UA=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
# Optional image fallback proxy: URL template with {url} (e.g. a Consumet-style
# endpoint or your own mirror). Tried automatically when MangaDex fails (429/403).
IMAGE_FALLBACK_PROXY=
# Set to false to disable the scheduled sync (manual trigger via admin panel still works)
MANGADEX_SYNC=true
# Cron interval: how often the background job refreshes (default 3 hours = 10800000 ms)
MANGADEX_SYNC_INTERVAL_MS=10800000
# Daily bulk: how many NEW works to pull every day (spec: 50–100)
MANGADEX_DAILY_LIMIT=75
MANGADEX_DAILY_INTERVAL_MS=86400000
# Ongoing tracking: refresh recently-updated / ongoing series this often
MANGADEX_ONGOING_INTERVAL_MS=1800000
MANGADEX_ONGOING_BATCH=25
# Bulk depth: pages of most-followed + recently-updated manga to pull
MANGADEX_SYNC_POPULAR_PAGES=3
MANGADEX_SYNC_LATEST_PAGES=2
MANGADEX_SYNC_PER_PAGE=50
# Pacing between MangaDex requests (ms) — keeps you under their rate limits
MANGADEX_AT_HOME_DELAY_MS=150
# Existing manga whose chapters get refreshed per scheduled run
MANGADEX_REFRESH_BATCH=10

# ── Rate limiting (requests per minute per IP) ─────────────────────────
RATE_LIMIT_API_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_IMAGE_PER_MIN=120

# ── Download limits (also editable later from the Admin → Settings panel) ──
DOWNLOAD_DAILY_LIMIT=11
REWARD_BONUS=5
REWARD_VALIDITY_HOURS=24
