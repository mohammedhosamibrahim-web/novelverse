{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "client/dist/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/sw.js", "dest": "/client/dist/sw.js", "headers": { "Cache-Control": "no-cache" } },
    { "src": "/manifest.json", "dest": "/client/dist/manifest.json", "headers": { "Cache-Control": "no-cache" } },
    { "src": "/(.*)", "dest": "/client/dist/$1" }
  ],
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  }
}
